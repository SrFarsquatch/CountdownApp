{
  "name": "quest-log",
  "private": true,
  "version": "0.1.0",
  "description": "Quest Log planner - shared self-hosted and Cloudflare deployment",
  "scripts": {
    "start": "node server.js",
    "dev:selfhosted": "node server.js",
    "dev:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "cloudflare:types": "wrangler types",
    "generate:vapid": "web-push generate-vapid-keys",
    "native:add:android": "npm run native:prepare && npx cap add android && npm run native:configure && npm run native:assets:android",
    "native:add:ios": "npm run native:prepare && npx cap add ios && npm run native:configure && npm run native:assets:ios",
    "native:sync": "npm run native:prepare && npx cap sync && npm run native:configure && npm run native:assets",
    "native:open:android": "npx cap open android",
    "native:open:ios": "npx cap open ios",
    "native:run:android": "npx cap run android",
    "native:run:ios": "npx cap run ios",
    "native:prepare": "node native/build.mjs",
    "native:configure": "node native/configure-platforms.mjs",
    "native:assets": "npx @capacitor/assets generate --iconBackgroundColor '#6c5ce7' --iconBackgroundColorDark '#6c5ce7' --splashBackgroundColor '#f3f2ef' --splashBackgroundColorDark '#1d1c20'",
    "native:assets:android": "npx @capacitor/assets generate --android --iconBackgroundColor '#6c5ce7' --iconBackgroundColorDark '#6c5ce7' --splashBackgroundColor '#f3f2ef' --splashBackgroundColorDark '#1d1c20'",
    "native:assets:ios": "npx @capacitor/assets generate --ios --iconBackgroundColor '#6c5ce7' --iconBackgroundColorDark '#6c5ce7' --splashBackgroundColor '#f3f2ef' --splashBackgroundColorDark '#1d1c20'"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "@capacitor/cli": "^8.5.2",
    "esbuild": "^0.25.0",
    "@capacitor/assets": "^3.0.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "web-push": "^3.6.7",
    "yahoo-finance2": "^4.0.2",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.11.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}
