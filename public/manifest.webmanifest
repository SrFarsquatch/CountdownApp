{
  "name": "Quest Log",
  "short_name": "Quest Log",
  "description": "Personal planner for calendars, tasks, goals, countdowns, weather, markets, Navi, and e-ink displays.",
  "id": "/questlog",
  "scope": "/",
  "start_url": "/login?source=pwa",
  "display": "standalone",
  "display_override": [
    "standalone"
  ],
  "background_color": "#f3f2ef",
  "theme_color": "#6c5ce7",
  "categories": [
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/branding/icon-quest-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/branding/icon-quest-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/branding/icon-classic-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Home",
      "short_name": "Home",
      "url": "/?view=today",
      "icons": [
        {
          "src": "/branding/icon-quest-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Planner",
      "short_name": "Planner",
      "url": "/?view=planner",
      "icons": [
        {
          "src": "/branding/icon-quest-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Tasks",
      "short_name": "Tasks",
      "url": "/?view=tasks",
      "icons": [
        {
          "src": "/branding/icon-quest-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
