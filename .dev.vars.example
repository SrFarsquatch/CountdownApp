# Copy this file to .dev.vars for local Cloudflare Worker development.
# Never commit .dev.vars.

# Native Quest Log authentication
# Set a long, stable APP_SECRET below.
# ALLOW_SIGNUPS=true
# ENFORCE_ALLOWED_EMAILS=no
# ALLOWED_EMAILS=you@example.com,friend@example.com
# LEGACY_OWNER_EMAIL=you@example.com
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Cloud-only integration secrets/variables are configured directly on the Worker:
# GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET
# APP_SECRET=replace-with-a-long-random-secret
# ALLOW_SIGNUPS=true
# LEGACY_OWNER_EMAIL=you@example.com
# TURNSTILE_SITE_KEY
# TURNSTILE_SECRET_KEY
# PLAID_CLIENT_ID
# PLAID_SECRET
# PLAID_ENV=sandbox
# PLAID_COUNTRY_CODES=CA
# YODLEE_CLIENT_ID
# YODLEE_SECRET
# YODLEE_API_URL=https://sandbox.api.yodlee.com/ysl
# YODLEE_FASTLINK_URL=https://fl4.sandbox.yodlee.com/authenticate/restserver/fastlink
# YODLEE_FASTLINK_CONFIG_NAME
# FLINKS_AUTH_KEY
# FLINKS_API_KEY
# FLINKS_API_BASE=https://<instance>-api.private.fin.ag/v3/<customerId>/BankingServices
# FLINKS_IFRAME_URL=https://<instance>-iframe.private.fin.ag/v2/
# FLINKS_REDIRECT_URL=https://questlog.example.com/flinks-oauth.html
#
# Cloud AI provider keys can normally be entered in Quest Log itself and encrypted into D1.
# The provider variables below are optional deployment-level fallbacks:
# OPENAI_API_KEY
# OPENAI_MODEL=gpt-5.6-luna
# ANTHROPIC_API_KEY
# ANTHROPIC_MODEL
# GEMINI_API_KEY
# GEMINI_MODEL
# OPENROUTER_API_KEY
# OPENROUTER_MODEL
# GROQ_API_KEY
# GROQ_MODEL
# MISTRAL_API_KEY
# MISTRAL_MODEL
# DEEPSEEK_API_KEY
# DEEPSEEK_MODEL
# XAI_API_KEY
# XAI_MODEL
# LOCAL_AGENT_BASE_URL
# LOCAL_AGENT_MODEL
# LOCAL_AGENT_API_KEY
# LOCAL_AGENT_ACCESS_CLIENT_ID
# LOCAL_AGENT_ACCESS_CLIENT_SECRET
# VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY
# VAPID_SUBJECT=mailto:you@example.com
#
# Native Android push (Firebase Cloud Messaging HTTP v1)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Native iOS push (Apple Push Notification service)
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# APNS_BUNDLE_ID=ca.mattmoonie.questlog
# APNS_SANDBOX=false
#
# Verified native web links
# ANDROID_APP_CERT_SHA256=AA:BB:CC:...
# APPLE_TEAM_ID=
#
# The standalone Cloudflare runtime does NOT use ORIGIN_BASE_URL,
# Cloudflare Tunnel, CasaOS, or origin service tokens.
