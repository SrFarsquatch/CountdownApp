# Copy this file to .dev.vars for local Cloudflare Worker development.
# Never commit .dev.vars.

AUTH_BYPASS=true
DEV_USER_EMAIL=local-dev@questlog.local
CLOUD_WORKSPACE_ID=default

# Production Access values:
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=your-access-application-aud
# ALLOWED_EMAILS=you@example.com

# Cloud-only integration secrets/variables are configured directly on the Worker:
# GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET
# APP_SECRET
# OPENAI_API_KEY
# OPENAI_MODEL=gpt-5.6-luna
# ALPHA_VANTAGE_API_KEY
#
# The standalone Cloudflare runtime does NOT use ORIGIN_BASE_URL,
# Cloudflare Tunnel, CasaOS, or origin service tokens.
